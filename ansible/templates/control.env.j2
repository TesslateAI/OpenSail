# Control environment: configuration and NONSECRET references only.
# Every credential is delivered under /etc/voie/secrets; the bootstrap
# admin password file is owned by the service account at 0600.
# /etc/voie/secrets by ansible/control.yml; this file carries only its
# *_FILE path. No secret value may appear here.
VOIE_DATABASE_URL_FILE=/etc/voie/secrets/postgres-dsn
VOIE_BIND=127.0.0.1:8080
VOIE_WEB_ROOT=/etc/voie/web-root
VOIE_PUBLIC_ORIGIN=https://{{ public_hostname }}
VOIE_AZURE_BLOB_ACCOUNT={{ blob_account_name }}
VOIE_AZURE_BLOB_CONTAINER={{ blob_container_name }}
VOIE_AZURE_BLOB_KEY_FILE=/etc/voie/secrets/blob-account-key
VOIE_FABRIC_CLIENT_CERT_PATH=/etc/voie/secrets/fabric-client.crt
VOIE_FABRIC_CLIENT_KEY_PATH=/etc/voie/secrets/fabric-client.key
VOIE_FABRIC_CA_CERT_PATH=/etc/voie/secrets/fabric-ca.crt
AZURE_CLIENT_ID={{ control_identity_client_id }}
AZURE_STORAGE_ACCOUNT={{ blob_account_name }}
AZURE_STORAGE_CONTAINER={{ blob_container_name }}
VOIE_KEY_VAULT_URI={{ user_secrets_key_vault_uri }}
# Scoped user secrets are server-owned in their isolated Key Vault. The
# control identity writes by deterministic `us-<uuid>` names and has no
# permission to read or enumerate this vault.
VOIE_USER_SECRETS_BACKEND=key-vault
VOIE_USER_SECRETS_PREFIX=us
# Auth mode is explicit: native-only by default (no OIDC discovery, no
# provider). VOIE_AUTH_NATIVE_ENABLED/VOIE_AUTH_OIDC_ENABLED restate the
# same selection as two flat flags; the backend parses only VOIE_AUTH_MODE,
# so these stay documentation-grade and must never diverge from it. Generic
# external OIDC is an opt-in plugin: when the oidc_* deployment inputs are
# present the mode widens to `both` (native login and the external provider
# coexist) unless no native admin is configured, in which case the estate
# stays pure OIDC.
{% if oidc_client_id is defined and native_admin_username is defined %}
VOIE_AUTH_MODE=both
VOIE_AUTH_NATIVE_ENABLED=1
VOIE_AUTH_OIDC_ENABLED=1
{% elif oidc_client_id is defined %}
VOIE_AUTH_MODE=oidc
VOIE_AUTH_NATIVE_ENABLED=0
VOIE_AUTH_OIDC_ENABLED=1
{% else %}
VOIE_AUTH_MODE=native
VOIE_AUTH_NATIVE_ENABLED=1
VOIE_AUTH_OIDC_ENABLED=0
{% endif %}
{% if native_admin_username is defined %}
VOIE_BOOTSTRAP_ADMIN_USERNAME={{ native_admin_username }}
VOIE_BOOTSTRAP_ADMIN_PASSWORD_FILE=/etc/voie/secrets/native-admin-password
{% endif %}
{% if blob_endpoint is defined %}
VOIE_AZURE_BLOB_ENDPOINT={{ blob_endpoint }}
{% endif %}
# The Fabric certificate identifies DNS:baremetal-1. Extra-vars may
# override the URL; the default is the product hostname, not a raw IP.
VOIE_FABRIC_ENDPOINT={{ fabric_endpoint | default('https://baremetal-1:7840') }}
{% if oidc_issuer is defined %}
VOIE_OIDC_ISSUER={{ oidc_issuer }}
{% endif %}
{% if oidc_client_id is defined %}
VOIE_OIDC_CLIENT_ID={{ oidc_client_id }}
{% endif %}
{% if oidc_client_secret is defined %}
VOIE_OIDC_CLIENT_SECRET_FILE=/etc/voie/secrets/oidc-client-secret
{% endif %}
{% if oidc_client_id is defined %}
VOIE_OIDC_REDIRECT_URL=https://{{ public_hostname }}/oidc/callback
{% endif %}
{% if model_base_url is defined %}
VOIE_MODEL_BASE_URL={{ model_base_url }}
{% endif %}
{% if model_name is defined %}
VOIE_MODEL_NAME={{ model_name }}
{% endif %}
{% if model_api_key is defined %}
VOIE_MODEL_API_KEY_FILE=/etc/voie/secrets/model-api-key
{% endif %}
