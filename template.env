# VOIE Cloud — deployment environment template
#
# Copy to voie-cloud.env (or another file), fill in real values, and point
# the deployment at it:
#
#   VOIE_C7_ENV_FILE=./template.env just live-c7
#
# SECURITY: this file carries live credentials. Keep it out of git
# (already covered by the repo's .env gitignore rules), mode 0600, and
# never commit or print its contents.
#
# Every name below is consumed by the data-only deployment parser
# (tests/live/deploy-env.sh). Names not in the parser allowlist are
# ignored, so extra shell variables in this file are harmless.

# ---------------------------------------------------------------------------
# Azure identity (service principal used by OpenTofu and Ansible).
# Role requirement: Contributor on the deployment subscription. The
# tfstate storage account needs its access key passed via
# VOIE_TF_BACKEND_HCL (see below) because listKeys is WAF-blocked for
# this identity class.
# ---------------------------------------------------------------------------
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# DNS (Cloudflare) — manages the public hostname and ACME challenge.
# ---------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
VOIE_BASE_DOMAIN=example.com
VOIE_PUBLIC_HOSTNAME=voie-dev.example.com

# ---------------------------------------------------------------------------
# Control VM image: exactly one of these two.
#   VOIE_CONTROL_IMAGE_ID       — existing Azure image resource id
#   VOIE_CONTROL_IMAGE_VHD_PATH — blob URL of a VHD built by `nix build`
# ---------------------------------------------------------------------------
VOIE_CONTROL_IMAGE_ID=
# VOIE_CONTROL_IMAGE_VHD_PATH=

# ---------------------------------------------------------------------------
# Estate networking / placement
# ---------------------------------------------------------------------------
VOIE_LOCATION=centralus
# CIDRs allowed to reach the management SSH endpoint (comma-separated).
VOIE_MANAGEMENT_CIDRS=
# Baremetal fabric target — always the literal SSH alias, never an IP.
VOIE_FABRIC_BOOTSTRAP_HOST=baremetal-1-cs
VOIE_SSH_USER=voie

# Block device for durable Workspaces on the fabric host.
# VOIE_WORKSPACE_PV_DEVICE=/dev/nvme0n1

# ---------------------------------------------------------------------------
# Native auth (default; OIDC login is optional and stays disabled unless
# the operator explicitly sets VOIE_OIDC_PROVISION=true).
# ---------------------------------------------------------------------------
VOIE_BOOTSTRAP_ADMIN_USERNAME=admin
VOIE_BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Optional: tfstate backend overrides. Without these, the backend names
# come from the cached .terraform state; if the deploy identity cannot
# list storage keys (WAF-blocked), pass a complete backend fragment file
# that carries the container/key/access_key — the recipe consumes the
# file by path and no secret value enters the env or logs.
# ---------------------------------------------------------------------------
# VOIE_TF_BACKEND_RESOURCE_GROUP=voie-r0-tfstate-rg
# VOIE_TF_BACKEND_STORAGE_ACCOUNT=
# VOIE_TF_BACKEND_CONTAINER=tfstate
# VOIE_TF_BACKEND_HCL=/secure/path/backend.hcl

# ---------------------------------------------------------------------------
# Optional overrides (sane defaults applied by the recipe when omitted).
# ---------------------------------------------------------------------------
# VOIE_OIDC_PROVISION=false
# VOIE_C7_WIPE=0
# VOIE_WIPE_VOIE_WS=DESTROY   # only when cutting over live voie-ws; destroys every LV
# ACME_EMAIL=ops@example.com