+/// Verify a pid still names this sandbox's own live Firecracker VMM before
+/// any signal is sent: comm must be `firecracker`, the start time must match
+/// the value captured when the pid was adopted (a recycled pid must not be
+/// killed), and the process must run under the jailer identity this sandbox
+/// owns.
+pub(crate) fn verify_vmm_identity(
+    pid: u32,
+    pid_starttime: Option<u64>,
+    jailer_identity: Option<&JailerIdentity>,
+) -> Result<()> {
+    let comm = proc_comm(pid)?;
+    if comm != "firecracker" {
+        bail!("pid {pid} is process {comm:?}, not firecracker");
+    }
+    let starttime = proc_starttime(pid)?;
+    match pid_starttime {
+        Some(expected) if expected == starttime => {}
+        Some(expected) => {
+            bail!(
+                "pid {pid} has start time {starttime}, not the persisted {expected}; \
+                 the pid was recycled"
+            )
+        }
+        None => bail!("pid {pid} has no persisted start time"),
+    }
+    let identity = jailer_identity.context("jailed Firecracker has no jailer identity")?;
+    let (uid, gid) = proc_identity(pid)?;
+    if uid != identity.uid() || gid != identity.gid() {
+        bail!(
+            "pid {pid} runs as {uid}:{gid}, not the jailer identity {}:{}; refusing to \
+             touch an unowned process",
+            identity.uid(),
+            identity.gid()
+        );
+    }
+    Ok(())
+}
+
+/// Field 22 (`starttime`) of /proc/<pid>/stat, the process start time in clock
+/// ticks since boot. After the final `)` of the comm field, index 0 is field 3
+/// (state), so field 22 is the 20th whitespace token of the remainder.
+pub(crate) fn proc_starttime(pid: u32) -> Result<u64> {
+    let stat = std::fs::read_to_string(format!("/proc/{pid}/stat"))
+        .with_context(|| format!("read /proc/{pid}/stat"))?;
+    let rest = stat.rsplit_once(')').map(|(_, rest)| rest).unwrap_or_default();
+    let starttime = rest
+        .split_whitespace()
+        .nth(19)
+        .context("short /proc stat line")?;
+    starttime
+        .parse::<u64>()
+        .with_context(|| format!("parse start time {starttime} of pid {pid}"))
+}
+
+/// The comm name of a process, read from /proc/<pid>/comm. A VMM pid must
+/// name the firecracker process before it may be signalled.
+pub(crate) fn proc_comm(pid: u32) -> Result<String> {
+    let comm = std::fs::read_to_string(format!("/proc/{pid}/comm"))
+        .with_context(|| format!("read /proc/{pid}/comm"))?;
+    Ok(comm.trim().to_owned())
+}
+
+/// The effective uid:gid of a process, read from /proc/<pid>/status.
+pub(crate) fn proc_identity(pid: u32) -> Result<(u32, u32)> {
+    let status = std::fs::read_to_string(format!("/proc/{pid}/status"))
+        .with_context(|| format!("read /proc/{pid}/status"))?;
+    let mut uid = None;
+    let mut gid = None;
+    for line in status.lines() {
+        if let Some(rest) = line.strip_prefix("Uid:") {
+            uid = rest.split_whitespace().next().and_then(|v| v.parse().ok());
+        } else if let Some(rest) = line.strip_prefix("Gid:") {
+            gid = rest.split_whitespace().next().and_then(|v| v.parse().ok());
+        }
+    }
+    let uid = uid.context("no Uid line in /proc status")?;
+    let gid = gid.context("no Gid line in /proc status")?;
+    Ok((uid, gid))
+}
+
+async fn wait_for_jailer_pid(child: &mut Child, pid_path: &Path) -> Result<u32> {
+    for _ in 0..100 {
+        if let Ok(contents) = tokio::fs::read_to_string(pid_path).await {
+            let pid = contents
+                .trim()
+                .parse::<u32>()
+                .with_context(|| format!("parse jailed Firecracker pid {}", pid_path.display()))?;
+            if pid == 0 || !Path::new(&format!("/proc/{pid}")).exists() {
+                bail!("jailed Firecracker pid {pid} is not alive");
+            }
+            return Ok(pid);
+        }
+        if let Some(status) = child.try_wait()? {
+            // With --new-pid-ns the jailer parent exits immediately after
+            // writing the real VMM pid. Give the filesystem one final read
+            // after observing that exit; otherwise a normal parent exit can
+            // be mistaken for a failed launch.
+            if let Ok(contents) = tokio::fs::read_to_string(pid_path).await {
+                let pid = contents
+                    .trim()
+                    .parse::<u32>()
+                    .with_context(|| {
+                        format!("parse jailed Firecracker pid {}", pid_path.display())
+                    })?;
+                if pid == 0 || !Path::new(&format!("/proc/{pid}")).exists() {
+                    bail!("jailed Firecracker pid {pid} is not alive");
+                }
+                return Ok(pid);
+            }
+            bail!(
+                "Firecracker jailer exited before writing {}: {status}",
+                pid_path.display()
+            );
+        }
+        sleep(Duration::from_millis(50)).await;
+    }
+    bail!(
+        "unable to determine Firecracker pid from jailer root after 5 seconds: {}",
+        pid_path.display()
+    );
+}
