+
+async fn wait_for_vmm_exit(pid: u32) -> Result<()> {
+    let proc_path = format!("/proc/{pid}/stat");
+    for _ in 0..100 {
+        match fs::read_to_string(&proc_path).await {
+            Ok(stat) if stat.rsplit_once(')').is_some_and(|(_, rest)| rest.starts_with(" Z")) => {
+                return Ok(())
+            }
+            Ok(_) => sleep(Duration::from_millis(50)).await,
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(()),
+            Err(error) => return Err(error).with_context(|| format!("read {proc_path}")),
+        }
+    }
+    Err(anyhow!(
+        "Firecracker pid {pid} did not terminate within 5 seconds"
+    ))
+}
+
+/// `MNT_DETACH` unmounts asynchronously.  The resource cleanup above may
+/// therefore return while a just-detached bind mount still makes the jail busy.
+/// Do not release the identity until the jail is positively gone.
+async fn remove_jail_after_detach(vm_path: &str) -> Result<()> {
+    let mut last_error = None;
+    for _ in 0..100 {
+        match std::fs::remove_dir_all(vm_path) {
+            Ok(()) => return Ok(()),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(()),
+            Err(error)
+                if matches!(
+                    error.kind(),
+                    std::io::ErrorKind::ResourceBusy | std::io::ErrorKind::DirectoryNotEmpty
+                ) =>
+            {
+                last_error = Some(error);
+                sleep(Duration::from_millis(50)).await;
+            }
+            Err(error) => {
+                return Err(error).with_context(|| format!("remove Firecracker jail {vm_path}"));
+            }
+        }
+    }
+    let error = last_error.expect("a failed jail-removal retry records its error");
+    Err(error).with_context(|| format!("Firecracker jail {vm_path} remained busy after 5 seconds"))
+}
diff --git a/src/runtime-rs/crates/hypervisor/src/firecracker/jailer_identity.rs b/src/runtime-rs/crates/hypervisor/src/firecracker/jailer_identity.rs
new file mode 100644
index 0000000..0a78e41
--- /dev/null
+++ b/src/runtime-rs/crates/hypervisor/src/firecracker/jailer_identity.rs
@@ -0,0 +1,244 @@
+// Copyright (c) 2026 The Kata Containers Contributors
+//
+// SPDX-License-Identifier: Apache-2.0
+
+//! Per-sandbox uid/gid allocation for the Firecracker jailer.
+//!
+//! The jailer changes the VMM to the requested uid/gid and only chowns the
+//! small set of directories and device nodes it creates. A single configured
+//! non-root user would therefore make every VMM share one host identity. This
+//! allocator reserves one uid/gid pair per sandbox from a configured range.
+//! Reservations use `O_EXCL` files under the root-owned Kata runtime directory,
+//! so concurrent runtime-rs shims cannot select the same pair silently.
+
+use anyhow::{bail, Context, Result};
+use sha2::{Digest, Sha256};
+use std::convert::TryFrom;
+use std::fs::{self, OpenOptions};
+use std::io::Write;
+use std::os::unix::fs::{OpenOptionsExt, PermissionsExt};
+use std::path::{Path, PathBuf};
+
+const RESERVATION_DIR: &str = ".jailer-identities";
+const MAX_PROBES: u64 = 1024;
+
+#[derive(Debug, Clone)]
+pub(crate) struct JailerIdentity {
+    uid: u32,
+    gid: u32,
+    reservation: PathBuf,
+}
+
+impl JailerIdentity {
+    pub(crate) fn restore(
+        chroot_base_dir: &Path,
+        sandbox_id: &str,
+        uid: u32,
+        gid: u32,
+    ) -> Result<Self> {
+        if uid == 0 || gid == 0 || uid != gid {
+            bail!("invalid persisted jailer identity uid={uid} gid={gid}");
+        }
+        let reservation = chroot_base_dir
+            .join(crate::HYPERVISOR_FIRECRACKER)
+            .join(RESERVATION_DIR)
+            .join(uid.to_string());
+        let existing = fs::read_to_string(&reservation).with_context(|| {
+            format!(
+                "read persisted jailer identity for sandbox {sandbox_id}: {}",
+                reservation.display()
+            )
+        })?;
+        if existing != sandbox_id {
+            bail!(
+                "jailer identity reservation {} belongs to a different sandbox",
+                reservation.display()
+            );
+        }
+        Ok(Self {
+            uid,
+            gid,
+            reservation,
+        })
+    }
+
+    pub(crate) fn reserve(
+        chroot_base_dir: &Path,
+        sandbox_id: &str,
+        uid_min: u32,
+        uid_max: u32,
+    ) -> Result<Self> {
+        if sandbox_id.is_empty() {
+            bail!("cannot allocate a jailer identity for an empty sandbox id");
+        }
+        if uid_min == 0 || uid_min > uid_max {
+            bail!("invalid jailer uid range {uid_min}..={uid_max}");
+        }
+
+        let reservation_dir = chroot_base_dir
+            .join(crate::HYPERVISOR_FIRECRACKER)
+            .join(RESERVATION_DIR);
+        fs::create_dir_all(&reservation_dir).with_context(|| {
+            format!("create jailer identity directory {}", reservation_dir.display())
+        })?;
+        fs::set_permissions(&reservation_dir, fs::Permissions::from_mode(0o700))
+            .with_context(|| format!("protect {}", reservation_dir.display()))?;
+
+        let span = u64::from(uid_max) - u64::from(uid_min) + 1;
+        let digest = Sha256::digest(sandbox_id.as_bytes());
+        let seed = u32::from_be_bytes([digest[0], digest[1], digest[2], digest[3]]) as u64;
+
+        for probe in 0..MAX_PROBES.min(span) {
+            let uid = u64::from(uid_min) + (seed + probe) % span;
+            let uid = u32::try_from(uid).expect("uid range is bounded by u32");
+            let reservation = reservation_dir.join(uid.to_string());
+
+            match OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .mode(0o600)
+                .open(&reservation)
+            {
+                Ok(mut file) => {
+                    file.write_all(sandbox_id.as_bytes())
+                        .with_context(|| format!("write {}", reservation.display()))?;
+                    file.sync_all()
+                        .with_context(|| format!("sync {}", reservation.display()))?;
+                    return Ok(Self {
+                        uid,
+                        gid: uid,
+                        reservation,
+                    });
+                }
+                Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => {
+                    let existing = fs::read_to_string(&reservation).unwrap_or_default();
+                    if existing == sandbox_id {
+                        return Ok(Self {
+                            uid,
+                            gid: uid,
+                            reservation,
+                        });
+                    }
+                }
+                Err(error) => {
+                    return Err(error).with_context(|| {
+                        format!("reserve jailer uid {uid} for sandbox {sandbox_id}")
+                    });
+                }
+            }
+        }
+
+        bail!(
+            "no free jailer uid in range {uid_min}..={uid_max} for sandbox {sandbox_id}"
+        );
+    }
+
+    pub(crate) fn uid(&self) -> u32 {
+        self.uid
+    }
+
+    pub(crate) fn gid(&self) -> u32 {
+        self.gid
+    }
+
+    pub(crate) fn release(&self) -> Result<()> {
+        match fs::remove_file(&self.reservation) {
+            Ok(()) => Ok(()),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(()),
+            Err(error) => Err(error)
+                .with_context(|| format!("release {}", self.reservation.display())),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::JailerIdentity;
+    use tempfile::tempdir;
+
+    #[test]
+    fn reserves_distinct_pairs_for_concurrent_sandboxes() {
+        let root = tempdir().unwrap();
+        let first = JailerIdentity::reserve(root.path(), "sandbox-a", 100_000, 100_010).unwrap();
+        let second =
+            JailerIdentity::reserve(root.path(), "sandbox-b", 100_000, 100_010).unwrap();
+        assert_ne!(first.uid(), second.uid());
+        assert_ne!(first.gid(), second.gid());
+        first.release().unwrap();
+        second.release().unwrap();
+    }
+
+    #[test]
+    fn refuses_an_exhausted_identity_range() {
+        let root = tempdir().unwrap();
+        let first = JailerIdentity::reserve(root.path(), "sandbox-a", 100_000, 100_000).unwrap();
+        let error = JailerIdentity::reserve(root.path(), "sandbox-b", 100_000, 100_000)
+            .unwrap_err()
+            .to_string();
+        assert!(error.contains("no free jailer uid"));
+        first.release().unwrap();
+    }
+
+    /// A restored sandbox must re-bind the identity it already owns.
+    ///
+    /// Restore runs when a shim recovers a sandbox whose VMM is still running
+    /// under the previously reserved uid. Allocating a fresh identity there would
+    /// leave the live VMM's uid reserved by nobody, so a later sandbox could be
+    /// handed the identity of a running guest.
+    #[test]
+    fn restores_the_identity_a_sandbox_already_owns() {
+        let root = tempdir().unwrap();
+        let reserved = JailerIdentity::reserve(root.path(), "sandbox-a", 100_000, 100_010).unwrap();
+
+        let restored =
+            JailerIdentity::restore(root.path(), "sandbox-a", reserved.uid(), reserved.gid())
+                .unwrap();
+        assert_eq!(restored.uid(), reserved.uid());
+        assert_eq!(restored.gid(), reserved.gid());
+
+        // The restored handle owns the same reservation, so releasing through it
+        // frees the uid for reuse rather than leaking it.
+        restored.release().unwrap();
+        let reused = JailerIdentity::reserve(root.path(), "sandbox-b", 100_000, 100_000).unwrap();
+        assert_eq!(reused.uid(), 100_000);
+        reused.release().unwrap();
+    }
+
+    /// Restore must refuse rather than adopt an identity it cannot prove is its
+    /// own. Every case below would otherwise put two sandboxes on one uid, or
+    /// restore the root identity this repair exists to eliminate.
+    #[test]
+    fn refuses_to_restore_an_identity_it_does_not_own() {
+        let root = tempdir().unwrap();
+        let reserved = JailerIdentity::reserve(root.path(), "sandbox-a", 100_000, 100_000).unwrap();
+
+        // Another sandbox's live reservation.
+        let error =
+            JailerIdentity::restore(root.path(), "sandbox-b", reserved.uid(), reserved.gid())
+                .unwrap_err()
+                .to_string();
+        assert!(error.contains("belongs to a different sandbox"), "{}", error);
+
+        // No reservation at all: the persisted state claims a uid the runtime
+        // directory does not corroborate.
+        let error = JailerIdentity::restore(root.path(), "sandbox-a", 200_000, 200_000)
+            .unwrap_err()
+            .to_string();
+        assert!(error.contains("read persisted jailer identity"), "{}", error);
+
+        // A persisted root identity is exactly the state this repair exists to
+        // prevent, so it must never be restorable.
+        let error = JailerIdentity::restore(root.path(), "sandbox-a", 0, 0)
+            .unwrap_err()
+            .to_string();
+        assert!(error.contains("invalid persisted jailer identity"), "{}", error);
+
+        // Mismatched uid/gid was never produced by this allocator.
+        let error = JailerIdentity::restore(root.path(), "sandbox-a", 100_000, 100_001)
+            .unwrap_err()
+            .to_string();
+        assert!(error.contains("invalid persisted jailer identity"), "{}", error);
+
+        reserved.release().unwrap();
+    }
+}
