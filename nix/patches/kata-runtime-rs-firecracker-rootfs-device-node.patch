 const DISK_POOL_SIZE: u32 = 6;
 
+fn host_block_rdev(src: &str) -> Result<(u64, u64)> {
+    match stat::stat(src) {
+        Ok(st) if SFlag::from_bits_truncate(st.st_mode) == SFlag::S_IFBLK => {
+            Ok((stat::major(st.st_rdev), stat::minor(st.st_rdev)))
+        }
+        Ok(_) => Err(anyhow!("{src} is not a block device")),
+        Err(err) => {
+            let name = src.rsplit('/').next().unwrap_or(src);
+            let sys = format!("/sys/block/{name}/dev");
+            let text = std::fs::read_to_string(&sys).with_context(|| {
+                format!("block device {src} is missing and {sys} is unreadable: {err}")
+            })?;
+            let mut parts = text.trim().split(':');
+            let major = parts
+                .next()
+                .ok_or_else(|| anyhow!("{sys} has no major"))?
+                .parse::<u64>()
+                .with_context(|| format!("parse major from {sys}"))?;
+            let minor = parts
+                .next()
+                .ok_or_else(|| anyhow!("{sys} has no minor"))?
+                .parse::<u64>()
+                .with_context(|| format!("parse minor from {sys}"))?;
+            Ok((major, minor))
+        }
+    }
+}
+
+fn wait_host_block_rdev(src: &str) -> Result<(u64, u64)> {
+    let mut last = anyhow!("jailed block device node {src} did not appear");
+    for _ in 0..100 {
+        match host_block_rdev(src) {
+            Ok(pair) => return Ok(pair),
+            Err(error) => last = error,
+        }
+        std::thread::sleep(Duration::from_millis(20));
+    }
+    Err(last)
+}
