+    fn jail_block_device(&self, src: &str, jailed_location: &str) -> Result<()> {
+        let (major, minor) = wait_host_block_rdev(src)?;
+        let _ = nix::mount::umount2(jailed_location, nix::mount::MntFlags::MNT_DETACH);
+        match std::fs::remove_file(jailed_location) {
+            Ok(()) => {}
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Err(error) => {
+                return Err(error).with_context(|| format!("remove leftover jail drive {jailed_location}"))
+            }
+        }
+        stat::mknod(
+            jailed_location,
+            SFlag::S_IFBLK,
+            Mode::from_bits_truncate(0o0600),
+            stat::makedev(major, minor),
+        )
+        .with_context(|| {
+            format!("mknod jailed block device node {jailed_location} from {src} {major}:{minor}")
+        })?;
+        self.chown_jailer_resource(jailed_location)?;
+        Ok(())
+    }
